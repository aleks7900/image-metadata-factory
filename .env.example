# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=imagemetadata
DB_USER=postgres
DB_PASSWORD=postgres

# LLM Provider Configuration
# Set to 'mock' for local offline testing (no API key required)
# Set to 'openai' for live OpenAI or compatible multimodal vision APIs
LLM_PROVIDER=mock

# OpenAI / Compatible API Settings (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Processing Concurrency and Resilience
PROCESSING_CONCURRENCY=5
MAX_RETRIES=3

# Storage Configuration
STORAGE_DIR=./storage/images
